# OpenRouter-only AI configuration.
# Add these variables in Render Environment Variables.
# You can use one key or rotate up to 12 keys.
OPENROUTER_API_KEY_1="YOUR_OPENROUTER_KEY_1"
OPENROUTER_API_KEY_2="YOUR_OPENROUTER_KEY_2"
OPENROUTER_API_KEY_3="YOUR_OPENROUTER_KEY_3"
OPENROUTER_API_KEY_4="YOUR_OPENROUTER_KEY_4"
OPENROUTER_API_KEY_5="YOUR_OPENROUTER_KEY_5"
OPENROUTER_API_KEY_6="YOUR_OPENROUTER_KEY_6"

# Optional: comma/newline separated alternative to the numbered keys.
# OPENROUTER_API_KEYS="key1,key2,key3"

# OpenRouter models. Keep these as OpenRouter model IDs.
OPENROUTER_MODELS="openai/gpt-4o-mini"

# Optional PDF parser engine supported by OpenRouter.
OPENROUTER_PDF_ENGINE="cloudflare-ai"

# Public URL used by OpenRouter request headers.
APP_URL="https://v-shiroya-policy.onrender.com"
